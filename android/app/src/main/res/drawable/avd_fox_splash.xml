<?xml version="1.0" encoding="utf-8"?>
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt">

    <aapt:attr name="android:drawable">
        <vector
            android:width="108dp"
            android:height="108dp"
            android:viewportWidth="108"
            android:viewportHeight="108">

            <group
                android:name="foxHeadGroup"
                android:pivotX="54"
                android:pivotY="54"
                android:scaleX="0.78"
                android:scaleY="0.78">

                <group
                    android:name="earsGroup"
                    android:pivotX="54"
                    android:pivotY="38">
                    <path
                        android:fillColor="#DA5B14"
                        android:pathData="M29,24 L31,45 L39,36 Z" />
                    <path
                        android:fillColor="#DA5B14"
                        android:pathData="M79,24 L69,36 L77,45 Z" />
                    <path
                        android:fillColor="#E96D1B"
                        android:pathData="M29,24 L45,35 L39,36 Z" />
                    <path
                        android:fillColor="#E96D1B"
                        android:pathData="M79,24 L69,36 L63,35 Z" />
                </group>

                <path
                    android:fillColor="#F58220"
                    android:pathData="M31,45 L45,35 L50,62 L26,57 Z" />
                <path
                    android:fillColor="#F58220"
                    android:pathData="M77,45 L82,57 L58,62 L63,35 Z" />
                <path
                    android:fillColor="#F8B62D"
                    android:pathData="M45,35 L63,35 L58,52 L57,72 L51,72 L50,52 Z" />
                <path
                    android:fillColor="#B38B59"
                    android:pathData="M33,66 L50,82 L58,82 L75,66 L69,75 L58,84 L50,84 L39,75 Z" />
                <path
                    android:fillColor="#F5EBD7"
                    android:pathData="M26,57 L50,62 L51,72 L54,79 L57,72 L58,62 L82,57 L74,67 L58,81 L50,81 L34,67 Z" />
                <path
                    android:fillColor="#1B2830"
                    android:pathData="M38,50 L47,55 L46,59 L39,57 Z" />
                <path
                    android:fillColor="#1B2830"
                    android:pathData="M70,50 L69,57 L62,59 L61,55 Z" />
                <path
                    android:fillColor="#1B2830"
                    android:pathData="M50,72 L58,72 L54,78 Z" />
            </group>
        </vector>
    </aapt:attr>

    <target android:name="foxHeadGroup">
        <aapt:attr name="android:animation">
            <set android:ordering="together">
                <objectAnimator
                    android:duration="560"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleX"
                    android:valueFrom="0.74"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
                <objectAnimator
                    android:duration="560"
                    android:interpolator="@android:interpolator/overshoot"
                    android:propertyName="scaleY"
                    android:valueFrom="0.74"
                    android:valueTo="1.0"
                    android:valueType="floatType" />
            </set>
        </aapt:attr>
    </target>

    <target android:name="earsGroup">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="620"
                android:interpolator="@android:interpolator/decelerate_quad"
                android:propertyName="translateY"
                android:valueFrom="2.5"
                android:valueTo="-1.0"
                android:valueType="floatType" />
        </aapt:attr>
    </target>
</animated-vector>
